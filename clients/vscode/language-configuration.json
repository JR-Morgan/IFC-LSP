{
  "comments": {
    "blockComment": ["/*", "*/"]
  },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["'", "'"]
  ],
  "wordPattern": "#[0-9]+|\\.[A-Za-z_][A-Za-z0-9_]*\\.|[-+]?[0-9]+\\.?[0-9]*(?:[Ee][-+]?[0-9]+)?|[A-Za-z_][A-Za-z0-9_]*"
}
