{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "express",
      "camelcase": "Express",
      "title": "EXPRESS",
      "scope": "source.express",
      "path": ".",
      "file-types": ["exp"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for EXPRESS (ISO 10303-11) schema files, highlighting only",
    "authors": [{ "name": "Speckle" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
