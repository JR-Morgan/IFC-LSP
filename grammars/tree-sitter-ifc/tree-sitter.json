{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ifc",
      "camelcase": "Ifc",
      "title": "IFC",
      "scope": "source.ifc",
      "path": ".",
      "file-types": ["ifc", "stp", "step", "p21"],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for ISO 10303-21 (STEP Part 21) files such as IFC",
    "authors": [{ "name": "Jedd Morgan" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
